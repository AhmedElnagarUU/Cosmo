# Copy to .env for local development.
# The app connects as cosmo_app, which is not an administrator, so row level security applies.
DATABASE_URL=postgres://cosmo_app:cosmo_app@localhost:5432/cosmo
# Migrations run as the owner of the tables.
MIGRATION_DATABASE_URL=postgres://cosmo_owner:cosmo_owner@localhost:5432/cosmo
# The address of the website. Requests that change data must come from here.
WEB_ORIGIN=http://localhost:3000
PORT=4000
# Set to true behind HTTPS in staging and production.
COOKIE_SECURE=false
