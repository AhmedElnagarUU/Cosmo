{
  "name": "cosmo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @cosmo/api --filter @cosmo/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @cosmo/api db:migrate"
  },
  "engines": {
    "node": ">=22"
  }
}
